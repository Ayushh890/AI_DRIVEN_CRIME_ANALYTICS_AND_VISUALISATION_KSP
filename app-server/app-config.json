{
  "name": "ksp-cip-server",
  "stack": "python_3_12",
  "memory": 1024,
  "buildPath": ".",
  "command": "bash start.sh",
  "env_variables": {
    "KSP_DB": "/tmp/ksp.db",
    "KSP_FIRS_ON_BOOT": "20000",
    "PYTHONUNBUFFERED": "1"
  },
  "scripts": {
    "predeploy": "python3 -m pip install --no-cache-dir --upgrade --platform manylinux2014_x86_64 --python-version 3.12 --only-binary=:all: -t . -r requirements.txt"
  }
}
