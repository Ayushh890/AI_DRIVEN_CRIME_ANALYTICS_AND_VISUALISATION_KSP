# Generated DB (rebuild via ./run.sh --rebuild)
data/*.db
data/*.db-journal
app-server/data/*.db
app-server/data/*.db-journal

# Catalyst-managed
.catalyst-deploy/
.catalyst_temp*

# Deploy-time secrets (API keys)
.env.deploy

# Runtime artifacts
.ksp.pid
.ksp.log
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# app-server/ is a build directory managed by build-catalyst.sh.
# Everything inside it is vendored / regenerated except the tiny set of
# hand-authored files we allowlist below. This keeps pip-installed deps
# (uvicorn/fastapi/pydantic/etc.) out of git while still committing the
# source we own.
app-server/*
!app-server/app-config.json
!app-server/start.sh
!app-server/requirements.txt
!app-server/backend
!app-server/backend/**
!app-server/frontend
!app-server/frontend/**
!app-server/data
!app-server/data/schema.sql
!app-server/scripts
!app-server/scripts/generate_data.py

# But do exclude pycache anywhere it appears
**/__pycache__/
