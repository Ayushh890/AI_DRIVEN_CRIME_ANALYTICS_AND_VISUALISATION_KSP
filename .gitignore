.catalyst-deploy/
.catalyst_temp*

# Runtime artifacts
.ksp.pid
.ksp.log
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Catalyst predeploy artifacts (installed into app-server/ by pip -t .)
app-server/fastapi*
app-server/starlette*
